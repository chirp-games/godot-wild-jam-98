[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Frog Mech"
2d_physics/layer_3="Enemies"
2d_physics/layer_4="Terrain"
2d_physics/layer_8="Scrap UI"

[physics]

2d/solver/solver_iterations=2400
2d/solver/contact_recycle_radius=0.0
2d/solver/contact_max_separation=0.0
2d/solver/contact_max_allowed_penetration=0.01

[rendering]

