; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="MechaFrog"
run/main_scene="uid://b7bl66hkxa4if"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://c3bctvykx7ims"
driver/mix_rate.web=44100

[autoload]

ConfigManager="*res://menu/config_manager.gd"
Resources="*uid://tkgk57d45pyo"
Vfx="*uid://bqwowsrk6mpl2"

[debug]

gdscript/warnings/directory_rules={
"res://addons": 0,
"res://include": 0
}

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[global_group]

statistic=""
mech_piece=""
wire=""
wire_receptacle=""
enemy=""
tower=""
player=""
game=""
bullet=""
ally=""
player_attack=""
enemy_attack=""
flare=""
frog_mech=""

[gui]

timers/tooltip_delay_sec=0.0
theme/custom="uid://bp35ok3gel4nx"
theme/custom_font="uid://5ldt5s4j5ox3"

